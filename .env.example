# Soroban Sentinel Environment Configuration Template
# Copy this file to .env and modify as needed for local testing:
# cp .env.example .env

# Soroban JSON-RPC 2.0 Endpoint
# Public Testnet: https://soroban-testnet.stellar.org
# Public Mainnet: https://mainnet.sorobanrpc.com
# Local Standalone: http://localhost:8000/soroban/rpc
SOROBAN_RPC_URL="https://soroban-testnet.stellar.org"

# Target Stellar Network (testnet, mainnet, futurenet, standalone)
STELLAR_NETWORK="testnet"

# Rust Logging Level (error, warn, info, debug, trace)
RUST_LOG="info"
